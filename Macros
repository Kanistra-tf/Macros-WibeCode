# ---------------- Виджет с фоновой картинкой ----------------
class BackgroundWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.pixmap = None
        self.dim_alpha = 60

    def set_background(self, path, dim_alpha=60):
        self.dim_alpha = dim_alpha
        if path and os.path.exists(path):
            self.pixmap = QPixmap(path)
            if self.pixmap.isNull():
                self.pixmap = None
        else:
            self.pixmap = None
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        if self.pixmap is not None:
            # cover-режим
            scaled = self.pixmap.scaled(
                self.size(), Qt.KeepAspectRatioByExpanding,
                Qt.SmoothTransformation)
            x = (self.width() - scaled.width()) // 2
            y = (self.height() - scaled.height()) // 2
            p.drawPixmap(x, y, scaled)
            p.fillRect(self.rect(), QColor(0, 0, 0, self.dim_alpha))
        else:
            p.fillRect(self.rect(), QColor(BG_DARK))


