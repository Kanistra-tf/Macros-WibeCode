    def refresh_header_hint(self):
        try:
            hr = (self.settings.get("hotkey_record") or "").upper()
            hp = (self.settings.get("hotkey_play") or "").upper()
            hs = (self.settings.get("hotkey_stop") or "").upper()
            self.header_hint.setText(
                f"{hr} — запись   |   {hp} — повтор   |   {hs} — стоп   "
                f"(меняется в настройках)")
        except Exception:
            pass

    # ==================== ФОН ====================
    def apply_background(self):
        path = self.settings.get("background_image", "")
        dim = int(self.settings.get("background_dim", 60))
        self.bg.set_background(path, dim)

    # ==================== ЛОГИ ====================
    def _append_log(self, msg):
        try:
            ts = time.strftime("%H:%M:%S")
            self.log_box.append(f"[{ts}] {msg}")
        except Exception:
            pass

    def _set_status(self, text, color):
        try:
            self.status_lbl.setText(f"●  {text}")
            self.status_lbl.setStyleSheet(
                f"color: {color}; font-weight: bold; font-size: 13px;")
        except Exception:
            pass

    def log(self, msg):
        # вызывается из UI-потока
        self._append_log(msg)

    def set_status(self, text, color):
        self._set_status(text, color)

    # ==================== СПИСОК МАКРОСОВ ====================
    def refresh_macro_list(self):
        self.list_widget.clear()
        files = sorted(MACROS_DIR.glob("*.json"))
        for f in files:
            self.list_widget.addItem(QListWidgetItem(f"  {f.stem}"))
        if files and self.current_macro is None:
            self.list_widget.setCurrentRow(0)
            self.current_macro = files[0].stem

    def _on_macro_select(self):
        it = self.list_widget.currentItem()
        self.current_macro = it.text().strip() if it else None

    def get_selected_name(self):
        it = self.list_widget.currentItem()
        return it.text().strip() if it else None

    def delete_macro(self):
        name = self.get_selected_name()
        if not name:
            self.log("Ничего не выбрано")
            return
        try:
            (MACROS_DIR / f"{name}.json").unlink()
            self.log(f"Удалён: {name}")
            self.current_macro = None
            self.refresh_macro_list()
        except Exception as e:
            self.log(f"⚠ Не удалось удалить: {e}")

    def rename_macro(self):
        name = self.get_selected_name()
        if not name:
            self.log("Ничего не выбрано")
            return
        dlg = NeonInputDialog(self, "Переименование", "Новое имя:", name)
        if dlg.exec_() != QDialog.Accepted:
            return
        new_name = "".join(c for c in dlg.get_value()
                           if c.isalnum() or c in " _-").strip()
        if not new_name or new_name == name:
            return
        try:
            (MACROS_DIR / f"{name}.json").rename(
                MACROS_DIR / f"{new_name}.json")
            self.log(f"Переименован: {name} → {new_name}")
            self.current_macro = None
            self.refresh_macro_list()
        except Exception as e:
            self.log(f"⚠ Ошибка: {e}")

    # ==================== ЗАПИСЬ ====================
    def toggle_recording(self):
        if self.recording:
            self.stop_recording()
        else:
            self.start_recording()

    def start_recording(self):
        if self.recording or self.playing:
            return
        self.record_events = []
        self.recording = True
        self.stop_flag = False
        self.record_start = time.time()

        self.rec_btn.setText("⏹  СТОП (запись)")
        self.rec_btn.setObjectName("PrimaryRec")
        self.rec_btn.style().unpolish(self.rec_btn)
        self.rec_btn.style().polish(self.rec_btn)

        self.set_status("ЗАПИСЬ...", RED)
        self.log("⏺ Запись началась")
        self.log(f"   Мышь: "
                 f"{'ВКЛ' if self.settings.get('record_mouse') else 'ВЫКЛ'}")

    def stop_recording(self):
        if not self.recording:
            return
        self.recording = False

        self.rec_btn.setText("⏺  ЗАПИСЬ")
        self.rec_btn.setObjectName("Primary")
        self.rec_btn.style().unpolish(self.rec_btn)
        self.rec_btn.style().polish(self.rec_btn)

        events = self.record_events
        self.record_events = []

        if not events:
            self.set_status("ГОТОВ", GREEN)
            self.log("⏹ Стоп — событий нет")
            return

        default_name = f"macro_{len(list(MACROS_DIR.glob('*.json'))) + 1}"
        dlg = NeonInputDialog(
            self, "Сохранение макроса",
            f"Имя макроса ({len(events)} событий):", default_name)
        if dlg.exec_() != QDialog.Accepted:
            self.set_status("ГОТОВ", GREEN)
            self.log("⏹ Сохранение отменено")
            return

        name = "".join(c for c in dlg.get_value()
                       if c.isalnum() or c in " _-").strip() or default_name

        try:
            (MACROS_DIR / f"{name}.json").write_text(
                json.dumps({"name": name, "events": events,
                            "created": time.time()}, ensure_ascii=False),
                encoding="utf-8")
            self.log(f"💾 Сохранён '{name}' — {len(events)} событий")
            self.current_macro = name
            self.refresh_macro_list()
            for i in range(self.list_widget.count()):
                if self.list_widget.item(i).text().strip() == name:
                    self.list_widget.setCurrentRow(i)
                    break
        except Exception as e:
            self.log(f"⚠ Ошибка сохранения: {e}")
        self.set_status("ГОТОВ", GREEN)

    # ==================== ВОСПРОИЗВЕДЕНИЕ ====================
    def toggle_playback(self):
        if self.playing:
            self.stop_flag = True
            return
        self.start_playback()

    def start_playback(self):
        if self.recording or self.playing:
            return
        name = self.current_macro or self.get_selected_name()
        if not name:
            self.log("Сначала выбери макрос")
            return

        path = MACROS_DIR / f"{name}.json"
        if not path.exists():
            self.log(f"Файл не найден: {path}")
            return

        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            events = data.get("events", [])
        except Exception as e:
            self.log(f"⚠ Ошибка чтения: {e}")
            return

        if not events:
            self.log("Макрос пустой")
            return

        try:
            speed = float(self.speed_edit.text()) or 1.0
            if speed <= 0:
                speed = 1.0
        except ValueError:
            speed = 1.0

        try:
            loops = int(self.loops_edit.text())
        except ValueError:
            loops = 1
        if loops == 0:
            loops = 10 ** 9

        self.playing = True
        self.stop_flag = False

        self.play_btn.setText("⏹  СТОП")
        self.play_btn.setObjectName("PrimaryRec")
        self.play_btn.style().unpolish(self.play_btn)
        self.play_btn.style().polish(self.play_btn)

        self.set_status("ВОСПРОИЗВЕДЕНИЕ", NEON_BLUE)
        self.log(f"▶ Старт '{name}' | событий: {len(events)} | "
                 f"циклов: {'∞' if loops > 10**8 else loops} | x{speed}")

        self.playback_thread = threading.Thread(
            target=self._playback_worker, args=(events, loops, speed),
            daemon=True)
        self.playback_thread.start()

    def _sleep_interruptible(self, seconds):
        end = time.time() + seconds
        while time.time() < end:
            if self.stop_flag:
                return False
            time.sleep(min(0.05, max(0, end - time.time())))
        return True

    def _playback_worker(self, events, loops, speed):
        kb = KBController()
        ms = MController()
        playback_mouse = self.settings.get("playback_mouse", True)
        random_on = self.settings.get("random_delay_enabled", False)
        rmin = float(self.settings.get("random_delay_min", 0.0))
        rmax = float(self.settings.get("random_delay_max", 0.0))
        loops_disp = "∞" if loops > 10 ** 8 else str(loops)

        for i in range(loops):
            if self.stop_flag:
                break
            self.signals.log.emit(f"  · цикл {i+1}/{loops_disp}")
            prev_t = 0.0
            for ev in events:
                if self.stop_flag:
                    break
                dt = (ev["t"] - prev_t) / speed
                prev_t = ev["t"]
                if random_on:
                    dt += random.uniform(rmin, rmax)
                if dt > 0 and not self._sleep_interruptible(dt):
                    break
                t = ev.get("type")
                try:
                    if t == "key_press":
                        kb.press(str_to_key(ev["key"]))
                    elif t == "key_release":
                        kb.release(str_to_key(ev["key"]))
                    elif t == "mouse_click" and playback_mouse:
                        ms.position = (ev["x"], ev["y"])
                        bstr = ev.get("button", "Button.left")
                        if "left" in bstr:
                            btn = Button.left
                        elif "right" in bstr:
                            btn = Button.right
                        else:
                            btn = Button.middle
                        (ms.press if ev.get("pressed") else ms.release)(btn)
                    elif t == "mouse_move" and playback_mouse:
                        ms.position = (ev["x"], ev["y"])
                except Exception as e:
                    self.signals.log.emit(f"  ⚠ {e}")

        self.signals.playback_done.emit()

    def _on_playback_finished(self):
        self.playing = False
        self.stop_flag = False
        self.play_btn.setText("▶  ВОСПРОИЗВЕСТИ")
        self.play_btn.setObjectName("Primary")
        self.play_btn.style().unpolish(self.play_btn)
        self.play_btn.style().polish(self.play_btn)
        self.set_status("ГОТОВ", GREEN)
        self.log("⏹ Воспроизведение завершено")

    # ==================== ХУКИ ====================
    def _hotkeys(self):
        return {self.settings.get("hotkey_record"),
                self.settings.get("hotkey_play"),
                self.settings.get("hotkey_stop")}

    def _on_key_press(self, key):
        try:
            ks = key_to_str(key)
            hk_rec = self.settings.get("hotkey_record")
            hk_play = self.settings.get("hotkey_play")
            hk_stop = self.settings.get("hotkey_stop")

            if not self.capturing:
                if ks == hk_stop and (self.recording or self.playing):
                    self.stop_flag = True
                    QTimer.singleShot(0, self._handle_stop)
                    return
                if ks == hk_rec and not self.recording and not self.playing:
                    QTimer.singleShot(0, self.start_recording)
                    return
                if ks == hk_play and not self.recording and not self.playing:
                    QTimer.singleShot(0, self.start_playback)
                    return

            if self.recording and ks not in self._hotkeys():
                self.record_events.append({
                    "t": time.time() - self.record_start,
                    "type": "key_press", "key": ks})
        except Exception:
            pass

    def _on_key_release(self, key):
        try:
            if not self.recording:
                return
            ks = key_to_str(key)
            if ks in self._hotkeys():
                return
            self.record_events.append({
                "t": time.time() - self.record_start,
                "type": "key_release", "key": ks})
        except Exception:
            pass

    def _on_click(self, x, y, button, pressed):
        try:
            if not self.recording or not self.settings.get("record_mouse"):
                return
            self.record_events.append({
                "t": time.time() - self.record_start,
                "type": "mouse_click", "x": x, "y": y,
                "button": str(button), "pressed": bool(pressed)})
        except Exception:
            pass

    def _on_move(self, x, y):
        try:
            if not self.recording or not self.settings.get("record_mouse"):
                return
            if self.record_events:
                last = self.record_events[-1]
                if last.get("type") == "mouse_move":
                    if abs(last["x"] - x) < 3 and abs(last["y"] - y) < 3:
                        return
            self.record_events.append({
                "t": time.time() - self.record_start,
                "type": "mouse_move", "x": x, "y": y})
        except Exception:
            pass

    def _handle_stop(self):
        if self.recording:
            self.stop_recording()

    # ==================== ПРОЧЕЕ ====================
    def open_settings(self):
        if self.recording or self.playing:
            self.log("Сначала останови запись/воспроизведение")
            return
        dlg = SettingsDialog(self)
        dlg.exec_()
        # на случай изменения фона/яркости
        self.apply_background()

    def closeEvent(self, event):
        try:
            self.stop_flag = True
            self.kb_listener.stop()
            self.ms_listener.stop()
        except Exception:
            pass
        save_settings(self.settings)
        event.accept()


