class NeonInputDialog(QDialog):
    def __init__(self, parent, title, prompt, initial=""):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setModal(True)
        self.setFixedSize(440, 190)

        v = QVBoxLayout(self)
        v.setContentsMargins(22, 22, 22, 18)
        v.setSpacing(14)

        lbl = QLabel(prompt)
        lbl.setObjectName("SectionTitle")
        v.addWidget(lbl)

        self.entry = QLineEdit(initial)
        self.entry.selectAll()
        v.addWidget(self.entry)

        row = QHBoxLayout()
        row.addStretch()

        cancel = QPushButton("Отмена")
        cancel.setObjectName("Ghost")
        cancel.clicked.connect(self.reject)
        row.addWidget(cancel)

        ok = QPushButton("OK")
        ok.setDefault(True)
        ok.clicked.connect(self.accept)
        row.addWidget(ok)

        v.addLayout(row)

        self.entry.setFocus()
        self.entry.returnPressed.connect(self.accept)

    def get_value(self):
        return self.entry.text().strip()


# ---------------- Диалог настроек ----------------
class SettingsDialog(QDialog):
    def __init__(self, app):
        super().__init__(app)
        self.app = app
        self.settings = app.settings
        self._capture_listener = None

        self.setWindowTitle("Настройки")
        self.setModal(True)
        self.setFixedSize(640, 800)

        root = QVBoxLayout(self)
        root.setContentsMargins(18, 18, 18, 18)
        root.setSpacing(12)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        content = QWidget()
        cv = QVBoxLayout(content)
        cv.setContentsMargins(4, 4, 4, 4)
        cv.setSpacing(14)

        self._build_hotkeys(cv)
        self._build_delays(cv)
        self._build_mouse(cv)
        self._build_bg(cv)
        cv.addStretch()

        scroll.setWidget(content)
        root.addWidget(scroll, 1)

        close_btn = QPushButton("ЗАКРЫТЬ")
        close_btn.setObjectName("Primary")
        close_btn.clicked.connect(self._close)
        root.addWidget(close_btn)

    def _close(self):
        save_settings(self.settings)
        self.app.refresh_header_hint()
        self.accept()

    def _section(self, parent, title):
        frame = QFrame()
        frame.setObjectName("Panel")
        v = QVBoxLayout(frame)
        v.setContentsMargins(18, 16, 18, 16)
        v.setSpacing(10)

        t = QLabel(title)
        t.setObjectName("SectionTitle")
        v.addWidget(t)

        parent.addWidget(frame)
        return frame, v

    # ----- горячие клавиши -----
    def _build_hotkeys(self, parent):
        frame, v = self._section(parent, "⌨  ГОРЯЧИЕ КЛАВИШИ")
        self._hotkey_row(v, "Начать запись", "hotkey_record")
        self._hotkey_row(v, "Воспроизвести последний", "hotkey_play")
        self._hotkey_row(v, "СТОП", "hotkey_stop")

    def _hotkey_row(self, parent, label, key_name):
        row = QHBoxLayout()
        row.setSpacing(10)

        lbl = QLabel(label)
        row.addWidget(lbl, 1)

        btn = QPushButton(self.settings.get(key_name, "").upper())
        btn.setObjectName("Ghost")
        btn.setFixedWidth(180)
        btn.setFixedHeight(34)
        btn.clicked.connect(lambda: self._start_capture(key_name, btn))
        row.addWidget(btn)

        parent.addLayout(row)

    def _start_capture(self, key_name, button):
        if self._capture_listener is not None:
            return
        self.app.capturing = True
        button.setText("Нажми клавишу...")
        button.setProperty("capturing", True)
        button.style().unpolish(button)
        button.style().polish(button)

        def on_press(key):
            ks = key_to_str(key)
            self.settings[key_name] = ks
            save_settings(self.settings)
            self.app.capturing = False
            self._capture_listener = None
            QTimer.singleShot(0, lambda: self._finish_capture(button, ks))
            return False

        listener = keyboard.Listener(on_press=on_press)
        listener.daemon = True
        listener.start()
        self._capture_listener = listener

    def _finish_capture(self, button, ks):
        button.setText(ks.upper())
        button.setProperty("capturing", False)
        button.style().unpolish(button)
        button.style().polish(button)
        self.app.refresh_header_hint()

    # ----- задержки -----
    def _build_delays(self, parent):
        frame, v = self._section(parent, "⏱  ЗАДЕРЖКИ")

        self.random_chk = QCheckBox(
            "Рандомная задержка (добавляется к каждому действию)")
        self.random_chk.setChecked(
            self.settings.get("random_delay_enabled", False))
        self.random_chk.stateChanged.connect(self._save_delays)
        v.addWidget(self.random_chk)

        row = QHBoxLayout()
        row.setSpacing(8)
        row.addWidget(QLabel("От:"))

        self.min_spin = QDoubleSpinBox()
        self.min_spin.setRange(0.0, 60.0)
        self.min_spin.setSingleStep(0.1)
        self.min_spin.setDecimals(2)
        self.min_spin.setValue(float(self.settings.get("random_delay_min", 0.5)))
        self.min_spin.setFixedWidth(90)
        self.min_spin.valueChanged.connect(self._save_delays)
        row.addWidget(self.min_spin)

        row.addSpacing(16)
        row.addWidget(QLabel("до:"))

        self.max_spin = QDoubleSpinBox()
        self.max_spin.setRange(0.0, 60.0)
        self.max_spin.setSingleStep(0.1)
        self.max_spin.setDecimals(2)
        self.max_spin.setValue(float(self.settings.get("random_delay_max", 1.5)))
        self.max_spin.setFixedWidth(90)
        self.max_spin.valueChanged.connect(self._save_delays)
        row.addWidget(self.max_spin)

        row.addWidget(QLabel("сек"))
        row.addStretch()
        v.addLayout(row)

    def _save_delays(self):
        self.settings["random_delay_enabled"] = self.random_chk.isChecked()
        self.settings["random_delay_min"] = self.min_spin.value()
        self.settings["random_delay_max"] = self.max_spin.value()
        save_settings(self.settings)

    # ----- мышь -----
    def _build_mouse(self, parent):
        frame, v = self._section(parent, "🖱  МЫШЬ")

        self.rec_mouse = QCheckBox("Записывать движения и клики мыши")
        self.rec_mouse.setChecked(self.settings.get("record_mouse", False))
        self.rec_mouse.stateChanged.connect(self._save_mouse)
        v.addWidget(self.rec_mouse)

        self.play_mouse = QCheckBox("Воспроизводить события мыши")
        self.play_mouse.setChecked(self.settings.get("playback_mouse", True))
        self.play_mouse.stateChanged.connect(self._save_mouse)
        v.addWidget(self.play_mouse)

    def _save_mouse(self):
        self.settings["record_mouse"] = self.rec_mouse.isChecked()
        self.settings["playback_mouse"] = self.play_mouse.isChecked()
        save_settings(self.settings)

    # ----- фон -----
    def _build_bg(self, parent):
        frame, v = self._section(parent, "🖼  ФОН ПРИЛОЖЕНИЯ")

        row = QHBoxLayout()
        row.setSpacing(8)

        self.bg_entry = QLineEdit(self.settings.get("background_image", ""))
        self.bg_entry.setReadOnly(True)
        row.addWidget(self.bg_entry, 1)

        pick = QPushButton("Обзор")
        pick.setFixedWidth(90)
        pick.clicked.connect(self._pick_bg)
        row.addWidget(pick)

        reset = QPushButton("Сброс")
        reset.setObjectName("Danger")
        reset.setFixedWidth(80)
        reset.clicked.connect(self._reset_bg)
        row.addWidget(reset)

        v.addLayout(row)

        # яркость фона
        dim_row = QHBoxLayout()
        dim_row.addWidget(QLabel("Затемнение фона:"))
        self.dim_spin = QDoubleSpinBox()
        self.dim_spin.setRange(0, 200)
        self.dim_spin.setSingleStep(10)
        self.dim_spin.setDecimals(0)
        self.dim_spin.setValue(self.settings.get("background_dim", 60))
        self.dim_spin.setFixedWidth(90)
        self.dim_spin.valueChanged.connect(self._save_dim)
        dim_row.addWidget(self.dim_spin)
        dim_row.addWidget(QLabel("(0 = ярко, 200 = темно)"))
        dim_row.addStretch()
        v.addLayout(dim_row)

        hint = QLabel(
            "Панели полупрозрачные — через них видно картинку. "
            "Прозрачность меняется константами PANEL_A, PANEL_A_2, PANEL_A_3 в файле.")
        hint.setObjectName("Dim")
        hint.setWordWrap(True)
        v.addWidget(hint)

    def _pick_bg(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Выбери картинку для фона", "",
            "Изображения (*.png *.jpg *.jpeg *.bmp *.gif *.webp);;Все файлы (*.*)")
        if path:
            self.bg_entry.setText(path)
            self.settings["background_image"] = path
            save_settings(self.settings)
            self.app.apply_background()

    def _reset_bg(self):
        self.bg_entry.setText("")
        self.settings["background_image"] = ""
        save_settings(self.settings)
        self.app.apply_background()

    def _save_dim(self):
        self.settings["background_dim"] = int(self.dim_spin.value())
        save_settings(self.settings)
        self.app.apply_background()


